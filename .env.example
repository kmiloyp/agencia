# ============================================================================
# Agencia — variables de entorno
# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local.
# ============================================================================

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=            # https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # clave pública "anon" / publishable
SUPABASE_SERVICE_ROLE_KEY=           # clave secreta service_role (solo servidor)

# --- Anthropic (Claude: director de arte, visión, búsqueda web, QC) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5        # identificador vigente verificado el 2026-09-22
ANTHROPIC_FALLBACKS=default          # "default" = reintento automático del servidor si Claude declina; "off" para desactivar

# --- fal.ai (generación de imágenes) ---
FAL_KEY=
# fal NO usa secreto compartido para webhooks: firma cada llamada con ED25519 y
# se verifica contra su JWKS público (https://rest.fal.ai/.well-known/jwks.json).
# Esta variable se conserva solo por compatibilidad con la especificación; se ignora.
FAL_WEBHOOK_SECRET=
FAL_MODO=auto                        # auto = real si hay FAL_KEY; stub = imágenes de ejemplo locales, sin costo

# --- Tareas programadas (Vercel Cron envía "Authorization: Bearer $CRON_SECRET") ---
CRON_SECRET=                         # cadena aleatoria larga: openssl rand -hex 32

# --- App ---
APP_BASE_URL=http://localhost:3000   # URL pública (https) en producción; se usa para el webhook de fal
PRESUPUESTO_MENSUAL_USD=50
PRESUPUESTO_POR_PROYECTO_USD=5
